{
  "manifestVersion": 2,
  "id": "knowledge_library",
  "name": "千星奇域知识库",
  "version": "0.2.0",
  "description": "知识库检索、文档浏览、本地向量模型与外部 MCP。",
  "icon": "book-open-check",
  "hostCompatibility": { "minCoreVersion": "0.1.0", "maxCoreVersionExclusive": "1.0.0", "protocol": { "minVersion": "1.0.0", "maxVersionExclusive": "2.0.0" } },
  "platform": { "os": "windows", "architecture": "x86_64", "abi": "msvc" },
  "ui": {
    "entry": "ui/index.html",
    "bridgeCompatibility": { "minVersion": "1.0.0", "maxVersionExclusive": "2.0.0" },
    "integrations": ["theme.followHost"],
    "contributions": [{ "id": "main", "kind": "activity", "title": "千星奇域知识库", "icon": "book-open-check", "defaultOrder": 600 }]
  },
  "backend": { "entry": "backend/wonderland-knowledge-library.exe", "transport": "stdio-ndjson-v1", "supportsServiceContext": true },
  "contract": "contract.json",
  "capabilities": ["network.public", "browser.open_official", "files.reveal_own"],
  "networkPublicHosts": ["act-webstatic.mihoyo.com"]
}
