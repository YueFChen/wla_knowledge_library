{
  "manifestVersion": 3,
  "id": "wla_knowledge_library",
  "name": "知识库",
  "version": "0.3.0",
  "description": "独立多库、资料构建、中英文检索与本地只读 MCP。",
  "icon": "book-open-check",
  "hostCompatibility": {
    "minCoreVersion": "0.2.1",
    "maxCoreVersionExclusive": "0.3.0",
    "protocol": {
      "minVersion": "1.0.0",
      "maxVersionExclusive": "2.0.0"
    }
  },
  "platform": {
    "os": "windows",
    "architecture": "x86_64",
    "abi": "msvc"
  },
  "ui": {
    "entry": "ui/index.html",
    "bridgeCompatibility": {
      "minVersion": "1.0.0",
      "maxVersionExclusive": "2.0.0"
    },
    "integrations": [
      "theme.followHost"
    ],
    "contributions": [
      {
        "id": "main",
        "kind": "activity",
        "title": "知识库",
        "icon": "book-open-check",
        "defaultOrder": 600
      }
    ]
  },
  "backend": {
    "entry": "backend/wla_knowledge_library.exe",
    "transport": "stdio-ndjson-v1",
    "supportsServiceContext": true,
    "activation": "on_demand"
  },
  "contract": "contract.json",
  "author": "YueFChen"
}
